# Скопируйте в .env (cp .env.example .env) и впишите ключи. Файл .env в git не попадает.

# Источник данных: demo — симулятор, plant — загруженные данные завода
ALLUR_DATA_MODE=demo

# ── ИИ: бесплатные LLM ─────────────────────────────────────────────────────────
# Достаточно одного ключа; с двумя — если один упрётся в лимит, ответит второй.
# Без ключей всё работает офлайн: выводы по шаблонам, разбор отчётов локальной моделью.
#
# Groq — бесплатный ключ: https://console.groq.com/keys (вход через Google/GitHub)
GROQ_API_KEY=
# Google Gemini — бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательно. Модели (несколько через запятую — при лимите берётся следующая):
# GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# Какой провайдер: auto (по очереди все, у кого есть ключ) | groq | gemini | off
# ALLUR_LLM_PROVIDER=auto
# Порядок для auto:
# ALLUR_LLM_ORDER=groq,gemini
